# OpenRouter API Key — https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional model override (default: anthropic/claude-sonnet-4)
# OPENROUTER_MODEL=anthropic/claude-sonnet-4

# Dev: use a canned roast script (no API tokens). Default ON in development.
# Set MOCK_ROAST=false to hit OpenRouter while running npm run dev.
MOCK_ROAST=true
